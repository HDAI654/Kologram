APP_NAME=notification_dispatcher
APP_ENV=development
LOG_LEVEL=INFO

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGES=auth.events,listing.events,chat.events
RABBITMQ_QUEUE=notification.dispatcher
RABBITMQ_PREFETCH=10

# 1/true/TRUE/yes → real SMTP; otherwise console (log only)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@kologram.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_MAX_ATTEMPTS=3

IDEMPOTENCY_DB_PATH=./data/idempotency.sqlite3
