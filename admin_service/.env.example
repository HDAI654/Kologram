APP_ENV=development
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Django admin panel local DB (staff users / sessions)
DJANGO_ADMIN_DB=./admin_panel.sqlite3

# AuthDB (Auth Service PostgreSQL — may be on another host)
AUTH_DB_ENGINE=django.db.backends.postgresql
AUTH_DB_NAME=auth
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432

# MarketDB (Market Service PostgreSQL — may be on another host)
MARKET_DB_ENGINE=django.db.backends.postgresql
MARKET_DB_NAME=market
MARKET_DB_USER=postgres
MARKET_DB_PASSWORD=postgres
MARKET_DB_HOST=localhost
MARKET_DB_PORT=5432
